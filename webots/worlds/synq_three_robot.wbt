#VRML_SIM R2025a utf8
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/mir/mir100/protos/Mir100.proto"
WorldInfo { basicTimeStep 32 }
Viewpoint { orientation 0 0 1 0 position 0 0 12 fieldOfView 1.1 }
RectangleArena { floorSize 15 15 }
DEF R1 Mir100 {
  translation -3 -1 0
  rotation 0 0 1 0
  name "R1"
  color 1 0.2 0.2
  controller "synq_controller"
  bodySlot [
    Emitter { name "peer_emitter" channel 1 }
    Receiver { name "peer_receiver" channel 1 }
  ]
}
DEF R2 Mir100 {
  translation -3 1 0
  rotation 0 0 1 0
  name "R2"
  color 0.2 1 0.2
  controller "synq_controller"
  bodySlot [
    Emitter { name "peer_emitter" channel 1 }
    Receiver { name "peer_receiver" channel 1 }
  ]
}
DEF R3 Mir100 {
  translation 0 -3 0
  rotation 0 0 1 1.5707963267948966
  name "R3"
  color 0.2 0.4 1
  controller "synq_controller"
  bodySlot [
    Emitter { name "peer_emitter" channel 1 }
    Receiver { name "peer_receiver" channel 1 }
  ]
}
DEF METRICS Robot {
  name "metrics"
  supervisor TRUE
  controller "synq_metrics"
  children [
    Receiver { name "telemetry_receiver" channel 1 }
    Emitter { name "safety_emitter" channel 1 }
  ]
}
