#VRML_SIM R2025a utf8
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/mir/mir100/protos/Mir100.proto"
WorldInfo { basicTimeStep 32 }
# Fixed camera: forward axis points toward the origin, z remains up.
Viewpoint {
  orientation -0.408248290464 0.408248290464 0.816496580928 1.772154247585
  position 0 -9 12
  fieldOfView 0.85
  near 0.1
  far 60
  followType "None"
  description "SYNQ three-AMR overview"
}
Background { skyColor [ 0.12 0.16 0.22 ] }
DirectionalLight {
  direction 0.3 0.4 -1
  ambientIntensity 0.65
  intensity 0.9
}
DirectionalLight { direction -1 -0.5 -1 intensity 0.35 }
RectangleArena {
  floorSize 15 15
  floorAppearance PBRAppearance {
    baseColor 0.28 0.32 0.37
    roughness 1
    metalness 0
  }
}
DEF R1 Mir100 {
  translation -3 -1 0
  rotation 0 0 1 0
  name "R1"
  color 1 0.2 0.2
  controller "synq_controller"
  bodySlot [
    # Identification marker only; no collision shape or mass.
    Pose { translation 0 0 0.06 children [
      Shape {
        castShadows FALSE
        appearance PBRAppearance { baseColor 0.95 0.12 0.14 emissiveColor 0.95 0.12 0.14 roughness 1 metalness 0 }
        geometry Box { size 0.4 0.3 0.025 }
      }
    ] }
    Emitter { name "peer_emitter" channel 1 }
    Receiver { name "peer_receiver" channel 1 }
  ]
}
DEF R2 Mir100 {
  translation -3 1 0
  rotation 0 0 1 0
  name "R2"
  color 0.2 1 0.2
  controller "synq_controller"
  bodySlot [
    # Identification marker only; no collision shape or mass.
    Pose { translation 0 0 0.06 children [
      Shape {
        castShadows FALSE
        appearance PBRAppearance { baseColor 0.12 0.8 0.24 emissiveColor 0.12 0.8 0.24 roughness 1 metalness 0 }
        geometry Box { size 0.4 0.3 0.025 }
      }
    ] }
    Emitter { name "peer_emitter" channel 1 }
    Receiver { name "peer_receiver" channel 1 }
  ]
}
DEF R3 Mir100 {
  translation 0 -3 0
  rotation 0 0 1 1.5707963267948966
  name "R3"
  color 0.2 0.4 1
  controller "synq_controller"
  bodySlot [
    # Identification marker only; no collision shape or mass.
    Pose { translation 0 0 0.06 children [
      Shape {
        castShadows FALSE
        appearance PBRAppearance { baseColor 0.12 0.38 1 emissiveColor 0.12 0.38 1 roughness 1 metalness 0 }
        geometry Box { size 0.4 0.3 0.025 }
      }
    ] }
    Emitter { name "peer_emitter" channel 1 }
    Receiver { name "peer_receiver" channel 1 }
  ]
}
DEF METRICS Robot {
  name "metrics"
  supervisor TRUE
  controller "synq_metrics"
  children [
    Receiver { name "telemetry_receiver" channel 1 }
    Emitter { name "safety_emitter" channel 1 }
  ]
}

